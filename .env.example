# Local secrets only — copy to `.env` and never commit that file.

# AWS (Kristen / Ryan). Leave blank on machines that only run SQLite.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# App database. SQLite for local; on AWS the same file is in private S3.
DATABASE_URL=sqlite:///data/occuscope.db

# Optional campus chat (Groq). Leave blank to get HTTP 503 on POST /chat.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
